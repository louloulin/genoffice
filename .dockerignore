# Repository-internal files that should never make it into a Docker image.
node_modules
dist
.git
.github
.vscode
.idea
.husky
.cache
.turbo
*.log
coverage
docs/.vitepress/cache
docs/.vitepress/dist
# fixtures are huge; web-server loads them lazily at runtime via DATA_DIR
packages/docx-engine/fixtures
packages/file-parse/fixtures
packages/pdf2docx/fixtures
packages/html2docx/fixtures
packages/pptx-engine/fixtures
# dev-only Playwright/E2E artifacts
playwright-report
test-results
e2e/screenshots
e2e/videos
# the new open-sdk artifacts (these are build outputs of the SDK itself,
# not part of the web-server image)
apps/sdk/dist
apps/sdk/node_modules
# screenshot artifacts left over from earlier sessions
*.png.bak
home-page.png
current-state.png
saas1.md
sdk1.md
storage:/

# Build outputs from the host. The image builds its own renderers and bundles
# (see tools/build-web-renderers.mjs); a stale `out/` on the build host must
# never be able to stand in for a build that failed.
**/node_modules
apps/*/out
apps/*/dist

# Scratch from verification sessions. Never part of an image.
.webverify-tmp

# Cargo build output (~1 GB of `target/`). The image runs no Rust build: the
# sheets renderer reaches the xlsx engine over HTTP, not through the native
# sidecar, so nothing in the image build reads this.
apps/sheets/native/**/target
