{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      // resolve workspace types from this checkout's sources: in a git worktree
      // node_modules is a symlink into the main checkout, so bare specifiers
      // would typecheck against the other checkout's (possibly stale) types
      "@genoffice/docx-engine": ["../../packages/docx-engine/src/index.ts"],
      "@genoffice/font-metrics": ["../../packages/font-metrics/src/index.ts"],
      "@genoffice/electron-utils/headless-export": [
        "../../packages/electron-utils/src/headless-export.ts"
      ],
      "@genoffice/electron-utils": ["../../packages/electron-utils/src/index.ts"],
      "@genoffice/ai-provider": ["../../packages/ai-provider/src/index.ts"],
      "@genoffice/i18n": ["../../packages/i18n/src/index.ts"],
      "@genoffice/ui": ["../../packages/ui/src/index.ts"],
      // The embed guest's staged progress (A22/A56) is SDK source; without
      // these two subpaths the typecheck gate runs against the main
      // checkout's dist and would not see the change at all.
      "@genoffice/web-sdk/dataflare/guest": ["../sdk/src/dataflare/guest.ts"],
      "@genoffice/web-sdk/dataflare/integration": ["../sdk/src/dataflare/integration.ts"]
    }
  },
  "include": ["src", "tests", "electron.vite.config.ts", "vitest.config.ts"]
}
