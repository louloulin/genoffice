{
  "name": "@genoffice/web-sdk",
  "version": "0.9.0-beta.1",
  "description": "Embeddable editor SDK for GenOffice \u2014 iframe / in-page editor with typed events and commands.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "browser": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "genoffice",
    "office",
    "ai",
    "sdk",
    "embed",
    "iframe",
    "wps-alternative",
    "documents",
    "spreadsheet",
    "presentation"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genspark-ai/genoffice.git",
    "directory": "apps/sdk"
  },
  "bugs": {
    "url": "https://github.com/genspark-ai/genoffice/issues"
  },
  "homepage": "https://genoffice.app/docs/sdk",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
