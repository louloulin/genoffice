{
  "name": "@genoffice/office-ai",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Headless Office document engine for Node: read, convert, render and op-level edit docx/xlsx/pptx/pdf (+md/html/csv) in-process, built on the same engines as the GenOffice apps. No Electron, no HTTP.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/office-ai.cjs",
  "module": "./dist/office-ai.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/office-ai.mjs",
      "require": "./dist/office-ai.cjs"
    },
    "./host": {
      "types": "./dist/types/ui/index.d.ts",
      "import": "./dist/host.mjs",
      "require": "./dist/host.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jsdom": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
