{
  "name": "@genoffice/skill-sheet-formula",
  "version": "0.1.0",
  "description": "Standalone GenOffice Skill — parses an Excel-style formula, explains it in plain English, and flags common mistakes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "keywords": ["genoffice", "skill", "spreadsheet", "formula", "excel"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependenciesMeta": {
    "@genoffice/agent-skills": { "optional": true }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
