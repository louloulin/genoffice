{
  "name": "@genoffice/provider-openai",
  "version": "0.1.0",
  "description": "OpenAI provider plugin for GenOffice \u2014 implements AiProviderPlugin.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "ai",
    "embed",
    "genoffice",
    "gpt",
    "iframe",
    "llm",
    "office",
    "openai",
    "provider",
    "sdk"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@genoffice/ai-provider": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genspark-ai/genoffice.git",
    "directory": "packages/provider-openai"
  },
  "bugs": {
    "url": "https://github.com/genspark-ai/genoffice/issues"
  },
  "homepage": "https://genoffice.app/docs/api"
}
