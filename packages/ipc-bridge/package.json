{
  "name": "@genoffice/ipc-bridge",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "HTTP+SSE bridge in front of ipcMain.handle \u2014 the same channels are served over IPC (Electron renderer) and HTTP (browser web version). '.' = main-process server (node:http), './client' = browser-safe transports.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./web-native": "./src/web-native.ts",
    "./web-tabs": "./src/web-tabs.ts",
    "./sdk-command-sink": "./src/sdk-command-sink.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genspark-ai/genoffice.git",
    "directory": "packages/ipc-bridge"
  },
  "bugs": {
    "url": "https://github.com/genspark-ai/genoffice/issues"
  },
  "homepage": "https://genoffice.app/docs/api",
  "keywords": [
    "ai",
    "genoffice",
    "ipc bridge",
    "office",
    "sdk"
  ]
}
