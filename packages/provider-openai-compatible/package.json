{
  "name": "@genoffice/provider-openai-compatible",
  "version": "0.1.0",
  "description": "Generic OpenAI-compatible provider plugin for GenOffice \u2014 wraps any OpenAI-format /v1/chat/completions endpoint (Together.ai, Fireworks, OpenRouter, Groq, DeepSeek, Moonshot Kimi, GLM, Qwen DashScope, Doubao, vLLM, llama.cpp, etc.).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "ai",
    "compatible",
    "dashscope",
    "deepseek",
    "doubao",
    "embed",
    "fireworks",
    "genoffice",
    "glm",
    "groq",
    "iframe",
    "kimi",
    "llama.cpp",
    "llm",
    "moonshot",
    "office",
    "openai",
    "openai-compatible",
    "openrouter",
    "provider",
    "qwen",
    "sdk",
    "together",
    "vllm"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@genoffice/ai-provider": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genspark-ai/genoffice.git",
    "directory": "packages/provider-openai-compatible"
  },
  "bugs": {
    "url": "https://github.com/genspark-ai/genoffice/issues"
  },
  "homepage": "https://genoffice.app/docs/api"
}
