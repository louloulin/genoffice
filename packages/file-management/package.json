{
  "name": "@genoffice/file-management",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Shared file-lifecycle kernel for the web-server and desktop builds: atomic writes, restart-safe recents, trash, save locations, file search/properties, and the DocumentStore interface the per-format stores implement (Node-only \u2014 uses fs/path/crypto; not browser-compatible).",
  "exports": {
    ".": "./src/index.ts",
    "./storage/key": "./src/storage/key.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genspark-ai/genoffice.git",
    "directory": "packages/file-management"
  },
  "bugs": {
    "url": "https://github.com/genspark-ai/genoffice/issues"
  },
  "homepage": "https://genoffice.app/docs/api",
  "keywords": [
    "ai",
    "file management",
    "genoffice",
    "office",
    "sdk"
  ]
}
