{
  "name": "@genoffice/translation-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Shared AI translation core: language list, hardened prompts, document chunking, provider wrapper, quality checks and an in-memory translation memory. The bare entry is Node-only (uses fs/path/crypto); the `./document` and `./embed-body` subpaths are browser-safe and carry no Node built-ins, so the same pipeline runs in the Electron main process, the web build and the Dataflare-embedded editor iframe.",
  "exports": {
    ".": "./src/index.ts",
    "./document": "./src/document.ts",
    "./embed-body": "./src/embed-body.ts",
    "./storage": "./src/storage.ts",
    "./translated-file-name": "./src/translated-file-name.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@genoffice/ai-provider": "*",
    "@genoffice/file-parse": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genspark-ai/genoffice.git",
    "directory": "packages/translation-core"
  },
  "bugs": {
    "url": "https://github.com/genspark-ai/genoffice/issues"
  },
  "homepage": "https://genoffice.app/docs/api",
  "keywords": [
    "ai",
    "genoffice",
    "office",
    "sdk",
    "translation core"
  ]
}
